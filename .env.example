# === LLM (z.ai GLM, OpenAI-compatible) ===
# Coding Plan key from https://docs.z.ai
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5-turbo

# === Scraper (Xquik) ===
XQUIK_API_KEY=
SCRAPE_HOURS=24
MAX_TWEETS_PER_ACCOUNT=20

# === Telegram ===
# Prod token stays on Railway only. For local dev, use a separate BotFather bot
# (e.g. @jtestcryptonewsbot) so local and Railway never share a token.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot.
# Empty = open to everyone. Local/prod can differ.
ALLOWED_USER_IDS=123456789,987654321

# === Storage ===
# On Railway: /data/agent.db (mounted volume).
# Local: ./data/agent.db or ./data/agent-dev.db (keeps test data separate).
DB_PATH=./data/agent.db

# === Local video pipeline ===
# Keep this on a fast local disk. Each job stores the upload, transcript,
# source package, storyboard screenshots, composition, and final MP4 here.
VIDEO_WORK_DIR=./data/video-jobs
# First test version accepts recordings up to 90 seconds.
VIDEO_MAX_SECONDS=90
# HyperFrames whisper.cpp model. small.en is the production default.
WHISPER_MODEL=small.en

# === LLM fallback (DeepSeek) ===
# Optional. When z.ai rate-limits, calls fall through to DeepSeek automatically.
# Omit (leave blank) if you do not want a fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
