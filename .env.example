# === LLM (z.ai GLM, OpenAI-compatible) ===
# Coding Plan key from https://docs.z.ai
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-4.6

# === Scraper (Xquik) ===
XQUIK_API_KEY=
SCRAPE_HOURS=24
MAX_TWEETS_PER_ACCOUNT=20

# === Telegram ===
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot.
# The presenter's ID goes here, plus yours for testing.
ALLOWED_USER_IDS=123456789,987654321

# === Storage ===
# On Railway: /data/agent.db (mounted volume). Local: ./data/agent.db
DB_PATH=/data/agent.db
